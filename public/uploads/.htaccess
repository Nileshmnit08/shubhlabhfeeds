# ==============================================================================
# Shubh Labh CMS - Uploads Directory Security Hardening
# ==============================================================================

# 1. Disable Directory Indexing and CGI execution
Options -Indexes -ExecCGI

# 2. Block execution and serving of non-image and executable file formats
<FilesMatch "(?i)\.(php|phtml|php[0-9]|phps|cgi|pl|py|sh|bash|exe|html|htm|js|svg|xml|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Disable PHP execution engine across all PHP handler variants
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 4. Enforce strict MIME-sniffing prevention headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
</IfModule>
